---
import Nav from "~/components/Nav.astro";
import PageLayout from "~/layouts/PageLayout.astro";
import Section from "~/components/Section.astro";
---

<PageLayout title="Grid">
  <Nav slot="chrome" />
  <div class="min-h-[100vh] py-20 pt-navh">
    <Section class="flex h-[80svh] w-full flex-col gap-2 px-gx">
      <h1 class="flex-center">Grid system</h1>
      <p class="text-center">use Shift+G to toggle grid view</p>
      <div class="flex flex-col gap-2 [&_div]:outline [&_div]:outline-gray-800">
        <div class="flex flex-wrap gap-gutter py-20">
          <div class="w-grids-1">1</div>
          <div class="w-grids-2">2</div>
          <div class="w-grids-3">3</div>
          <div class="w-grids-4">4</div>
          <div class="w-grids-5">5</div>
          <div class="w-grids-6">6</div>
          <div class="w-grids-7">7</div>
          <div class="w-grids-8">8</div>
          <div class="w-grids-9">9</div>
        </div>
      </div>
    </Section>
  </div>
</PageLayout>
